{
  "name": "tariff-resolver",
  "version": "1.0.0",
  "mcpName": "io.github.opsloft/tariff-resolver",
  "description": "MCP server: US HTS tariff lookup, chapter-99 additional-duty rules, and landed-cost components from official USITC public-domain data. Not affiliated with any government agency.",
  "type": "module",
  "license": "MIT",
  "author": "Opsloft <npm@opsloft.dev>",
  "homepage": "https://opsloft.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opsloft/tariff-resolver.git"
  },
  "bugs": {
    "url": "https://github.com/opsloft/tariff-resolver/issues"
  },
  "bin": {
    "tariff-resolver": "dist/index.js"
  },
  "files": [
    "dist",
    "data/hts_full.json",
    "data/hts_meta.json",
    "scripts/fetch_hts.py",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "tariff",
    "hts",
    "hs-code",
    "landed-cost",
    "customs",
    "duty",
    "import",
    "usitc",
    "section-301",
    "de-minimis"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "node --test test/data.test.mjs test/smoke.test.mjs",
    "coverage": "c8 node --test test/data.test.mjs test/smoke.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "c8": "^12.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18"
  },
  "c8": {
    "include": [
      "dist/**"
    ],
    "check-coverage": true,
    "statements": 95,
    "lines": 95,
    "functions": 95,
    "branches": 70,
    "reporter": [
      "text",
      "lcov"
    ]
  }
}
